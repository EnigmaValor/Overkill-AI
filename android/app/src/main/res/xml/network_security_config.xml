<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. No cleartext traffic, no user CAs (GrapheneOS friendly). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
